{
  "title": "Beacon AED finder input",
  "type": "object",
  "schemaVersion": 1,
  "properties": {
    "lat": {
      "title": "Latitude",
      "type": "number",
      "editor": "number",
      "description": "WGS84 latitude of the incident"
    },
    "lng": {
      "title": "Longitude",
      "type": "number",
      "editor": "number",
      "description": "WGS84 longitude of the incident"
    },
    "radiusM": {
      "title": "Search radius (m) for AEDs",
      "type": "integer",
      "editor": "number",
      "default": 800,
      "minimum": 100,
      "maximum": 5000,
      "description": "Search radius in metres for AEDs (hospitals/shelters use 4x this)"
    },
    "kinds": {
      "title": "Resource kinds",
      "type": "array",
      "editor": "select",
      "items": {
        "type": "string",
        "enum": [
          "aed",
          "hospital",
          "fire_station",
          "shelter"
        ]
      },
      "default": [
        "aed",
        "hospital"
      ],
      "description": "Which resource types to return"
    },
    "includeRegistries": {
      "title": "Also query public AED registries (PulsePoint / city open data) where available",
      "type": "boolean",
      "default": true,
      "description": "Also query city open-data AED registries when the point is inside a covered city"
    }
  },
  "required": [
    "lat",
    "lng"
  ]
}
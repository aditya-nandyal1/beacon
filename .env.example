# ─────────────────────────────────────────────────────────────────────────────
# Beacon environment
# Convex env vars are set with:  npx convex env set KEY value
# Browser-side vars live in apps/web/.env.local (VITE_ prefix) — never secrets.
# Every integration below is OPTIONAL. If a key is missing the matching adapter
# degrades to a deterministic local fallback so the demo never dies on stage.
# ─────────────────────────────────────────────────────────────────────────────

# ── Core brain (Anthropic) ───────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-5          # vision triage + coaching turns
ANTHROPIC_FAST_MODEL=claude-haiku-4-5      # cheap re-checks (hand position, hazard drift)

# ── Fallback model provider (Bitdeer AI Model Studio, OpenAI-compatible) ─────
BITDEER_API_KEY=
BITDEER_BASE_URL=https://api-inference.bitdeer.ai/v1
BITDEER_MODEL=

# ── Voice (Cartesia) — browser gets a 5-minute scoped access token minted by Convex ──────
CARTESIA_API_KEY=sk_car_...
CARTESIA_VOICE_ID=                       # leave blank for default calm voice
CARTESIA_TTS_MODEL=sonic-2
CARTESIA_STT_MODEL=ink-whisper

# ── Alerting ─────────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# NG911 / PSAP data channel (RapidSOS-style). Beacon POSTs an incident packet here.
# Dialling 911 itself is always done by the user via the one-tap tel: link — by design.
DISPATCH_WEBHOOK_URL=
DISPATCH_WEBHOOK_SECRET=

# ── Live public web context (Bright Data) ────────────────────────────────────
BRIGHTDATA_API_KEY=
BRIGHTDATA_ZONE=beacon_unlocker

# ── Nearby resources (Apify actor: AED / shelter finder) ─────────────────────
APIFY_TOKEN=
APIFY_AED_ACTOR_ID=                       # e.g. your-org/beacon-aed-finder

# ── Search & analytics (Elastic) ─────────────────────────────────────────────
ELASTIC_URL=
ELASTIC_API_KEY=
ELASTIC_INDEX=beacon-incidents

# ── After-action automation (Factory Droid) ──────────────────────────────────
FACTORY_API_KEY=
DROID_WEBHOOK_URL=                        # where Convex notifies the Droid runner on incident close
DROID_WEBHOOK_SECRET=

# ── Ticketing (Atlassian Jira) ───────────────────────────────────────────────
JIRA_BASE_URL=https://your-org.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=BEACON

# ── Helper dispatch agent (Fetch.ai uAgent) ──────────────────────────────────
FETCHAI_AGENT_ADDRESS=
FETCHAI_AGENT_ENDPOINT=                   # http://localhost:8001/submit in dev
AGENTVERSE_API_KEY=

# ── Shared secret used by Convex HTTP endpoints ──────────────────────────────
BEACON_INTERNAL_SECRET=change-me
